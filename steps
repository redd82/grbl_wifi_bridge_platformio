static bool usb_rx_cb(const uint8_t *data, size_t len, void *user_arg)
{
    // Keep this fast. Drop data if the buffer is full.
    scan_for_idle(data, len);                      // <-- added
    xStreamBufferSend(g_usb_rx, data, len, 0);
    return true;
}

